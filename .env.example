# --- Active provider -----------------------------------------------------
# One of: openai | gemini | anthropic | openrouter | ollama | custom
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini

# --- Credentials (fill in only the provider you use) ---------------------
OPENAI_API_KEY=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OLLAMA_BASE_URL=http://localhost:11434
CUSTOM_LLM_BASE_URL=
CUSTOM_LLM_API_KEY=

# --- Optional pipeline flags ---------------------------------------------
# REFRESH_SOURCE=1     # re-fetch from Crossref instead of reusing data/raw/
# REFRESH_TEST_SET=1   # rebuild data/eval/test_set.json (keep OFF once frozen)
# RUN_RAGAS=1          # enable the slow Ragas metric pass (off by default)
